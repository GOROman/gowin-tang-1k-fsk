// Tang Nano 1K (GW1NZ-LV1QN48C6/I5)
IO_LOC  "clk_27m" 47;
IO_PORT "clk_27m" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// External passive buzzer output on the P2 header (FPGA pin 35 / LCD_R0).
IO_LOC  "buzzer" 35;
IO_PORT "buzzer" DRIVE=8 IO_TYPE=LVCMOS33;

// User buttons are active-low on Tang Nano 1K.
IO_LOC  "key_a_n" 13;
IO_PORT "key_a_n" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "key_b_n" 44;
IO_PORT "key_b_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Onboard RGB LED green channel, active-low.
IO_LOC  "led_g_n" 11;
IO_PORT "led_g_n" DRIVE=8 IO_TYPE=LVCMOS33;
